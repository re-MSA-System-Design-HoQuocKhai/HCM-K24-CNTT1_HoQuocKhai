{
  "info": {
    "name": "ShopMart - Microservices Session 14",
    "description": "Postman Collection đầy đủ cho ShopMart Microservices:\n- Test trực tiếp các service (8081, 8082, 8083)\n- Test qua API Gateway (8080)\n- Test FeignClient + Load Balancing + Circuit Breaker (Resilience4j)\n- Test Distributed Transaction Saga (Choreography) + Compensating Rollback khi Payment thất bại\n- Test Redis Cache-Aside (@Cacheable, @CachePut, @CacheEvict)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "orderUrl", "value": "http://localhost:8081" },
    { "key": "inventoryUrl", "value": "http://localhost:8082" },
    { "key": "paymentUrl", "value": "http://localhost:8083" }
  ],
  "item": [
    {
      "name": "1. API Gateway (Port 8080)",
      "item": [
        {
          "name": "Gateway - Inventory Instance (Load Balancing test)",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/inventory/instance" }
        },
        {
          "name": "Gateway - Get all products (Inventory)",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/inventory/products" }
        },
        {
          "name": "Gateway - Get product by id (Inventory)",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/inventory/products/1" }
        },
        {
          "name": "Gateway - FeignClient & CircuitBreaker (Order -> Inventory)",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/order/products/1" }
        },
        {
          "name": "Gateway - Create Order (Happy Path Saga)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"C001\",\n  \"productId\": 1,\n  \"quantity\": 2\n}" },
            "url": "{{gatewayUrl}}/api/order"
          }
        },
        {
          "name": "Gateway - Create Order (Rollback when Payment Fails > 80M)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"C002\",\n  \"productId\": 3,\n  \"quantity\": 3\n}" },
            "url": "{{gatewayUrl}}/api/order"
          }
        },
        {
          "name": "Gateway - Get order by id",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/order/1" }
        },
        {
          "name": "Gateway - Get all orders",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/order" }
        },
        {
          "name": "Gateway - Get payment by orderId",
          "request": { "method": "GET", "url": "{{gatewayUrl}}/api/payment/1" }
        }
      ]
    },
    {
      "name": "2. Inventory Service (Port 8082)",
      "item": [
        {
          "name": "Get instance port (Load Balancing)",
          "request": { "method": "GET", "url": "{{inventoryUrl}}/api/inventory/instance" }
        },
        {
          "name": "Get all products",
          "request": { "method": "GET", "url": "{{inventoryUrl}}/api/inventory/products" }
        },
        {
          "name": "Get product by id (@Cacheable Cache-Aside)",
          "request": { "method": "GET", "url": "{{inventoryUrl}}/api/inventory/products/1" }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"iPad Air M2\",\n  \"price\": 16000000,\n  \"stock\": 15\n}" },
            "url": "{{inventoryUrl}}/api/inventory/products"
          }
        },
        {
          "name": "Update product (@CachePut)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"price\": 24000000,\n  \"stock\": 50\n}" },
            "url": "{{inventoryUrl}}/api/inventory/products/1"
          }
        },
        {
          "name": "Decrease stock (@CacheEvict)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{inventoryUrl}}/api/inventory/products/1/decrease"
          }
        },
        {
          "name": "Increase stock / Compensate (@CacheEvict)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{inventoryUrl}}/api/inventory/products/1/increase"
          }
        },
        {
          "name": "Delete product (@CacheEvict)",
          "request": {
            "method": "DELETE",
            "url": "{{inventoryUrl}}/api/inventory/products/1"
          }
        }
      ]
    },
    {
      "name": "3. Payment Service (Port 8083)",
      "item": [
        {
          "name": "Pay (success)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1001,\n  \"amount\": 25000000\n}" },
            "url": "{{paymentUrl}}/api/payment"
          }
        },
        {
          "name": "Pay (fail - over max-amount 80M)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1002,\n  \"amount\": 84000000\n}" },
            "url": "{{paymentUrl}}/api/payment"
          }
        },
        {
          "name": "Refund (compensate)",
          "request": { "method": "POST", "url": "{{paymentUrl}}/api/payment/1001/refund" }
        },
        {
          "name": "Get payment by orderId",
          "request": { "method": "GET", "url": "{{paymentUrl}}/api/payment/1001" }
        },
        {
          "name": "Get all payments",
          "request": { "method": "GET", "url": "{{paymentUrl}}/api/payment" }
        }
      ]
    },
    {
      "name": "4. Order Service (Port 8081)",
      "item": [
        {
          "name": "FeignClient & CircuitBreaker - Get product from inventory",
          "request": { "method": "GET", "url": "{{orderUrl}}/api/order/products/1" }
        },
        {
          "name": "Create order (happy path Saga)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"C001\",\n  \"productId\": 1,\n  \"quantity\": 2\n}" },
            "url": "{{orderUrl}}/api/order"
          }
        },
        {
          "name": "Create order (payment fail -> Saga rollback)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"C002\",\n  \"productId\": 3,\n  \"quantity\": 3\n}" },
            "url": "{{orderUrl}}/api/order"
          }
        },
        {
          "name": "Get order by id",
          "request": { "method": "GET", "url": "{{orderUrl}}/api/order/1" }
        },
        {
          "name": "Get all orders",
          "request": { "method": "GET", "url": "{{orderUrl}}/api/order" }
        }
      ]
    }
  ]
}
